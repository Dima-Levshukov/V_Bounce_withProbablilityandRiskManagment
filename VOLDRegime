//@version=6
indicator("Dimas_RFVG",
     overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

//==================================================
// SESSION SETTINGS
//==================================================
sessionRTH       = input.session("0930-1600", "RTH Session (Exchange Time)")
entryStartMin    = input.int(30, "Entries start minutes after open", minval=0, maxval=240)
entryStopMin     = input.int(60, "Entries stop minutes before close", minval=0, maxval=240)

//==================================================
// VISIBILITY
//==================================================
groupVis = "Visibility"
show5mTF         = input.bool(true, "Show 5m FVGs", group=groupVis)
show15mTF        = input.bool(true, "Show 15m FVGs", group=groupVis)
showUnfilled     = input.bool(true, "Show Unfilled FVGs", group=groupVis)
showFilled       = input.bool(true, "Show Filled FVGs", group=groupVis)
showInversed     = input.bool(true, "Show Inversed FVGs", group=groupVis)

//==================================================
// FVG LIMITS
//==================================================
groupLimits = "FVG Limits"
maxNormalFvgs = input.int(10, "Max Normal FVGs to Keep", minval=1, maxval=50, group=groupLimits)
maxIfvgs      = input.int(5,  "Max Inversed FVGs to Keep", minval=1, maxval=30, group=groupLimits)

//==================================================
// DRAW / STYLE SETTINGS
//==================================================
groupDraw = "Draw Settings"
extendBars  = input.int(100, "Extend FVG boxes (chart bars)", minval=10, maxval=500, group=groupDraw)

txt5        = input.string("5min FVG",  "5m Label Text", group=groupDraw)
txt15       = input.string("15min FVG", "15m Label Text", group=groupDraw)
txtInv      = input.string("FVG Inversed", "Inversed Label Text", group=groupDraw)
labelBgCol  = input.color(color.new(color.white, 100), "Label Background Color", group=groupDraw)

groupColors = "Colors"
bullUnfilledBox   = input.color(color.new(color.lime, 70),  "Bull Unfilled - Box", group=groupColors)
bullUnfilledBord  = input.color(color.lime,                "Bull Unfilled - Border", group=groupColors)
bullUnfilledText  = input.color(color.black,               "Bull Unfilled - Text", group=groupColors)

bullFilledBox     = input.color(color.new(color.green, 15), "Bull Filled - Box", group=groupColors)
bullFilledBord    = input.color(color.green,               "Bull Filled - Border", group=groupColors)
bullFilledText    = input.color(color.white,               "Bull Filled - Text", group=groupColors)

bearUnfilledBox   = input.color(color.new(color.red, 70),   "Bear Unfilled - Box", group=groupColors)
bearUnfilledBord  = input.color(color.red,                 "Bear Unfilled - Border", group=groupColors)
bearUnfilledText  = input.color(color.black,               "Bear Unfilled - Text", group=groupColors)

bearFilledBox     = input.color(color.new(color.maroon, 10),"Bear Filled - Box", group=groupColors)
bearFilledBord    = input.color(color.maroon,              "Bear Filled - Border", group=groupColors)
bearFilledText    = input.color(color.white,               "Bear Filled - Text", group=groupColors)

invBox            = input.color(color.new(color.gray, 80),  "Inversed - Box", group=groupColors)
invBord           = input.color(color.gray,                "Inversed - Border", group=groupColors)
invText           = input.color(color.white,               "Inversed - Text", group=groupColors)

//==================================================
// VWAP SETTINGS
//==================================================
groupVwap = "VWAP"
vwapCol     = input.color(color.yellow, "Session VWAP Color", group=groupVwap)
vwapWidth   = input.int(1, "Session VWAP Width", minval=1, maxval=4, group=groupVwap)
keepVwapSessions = input.int(20, "How many VWAP sessions to keep drawn", minval=1, maxval=200, group=groupVwap)
vwapSlippage = input.float(0.25, "VWAP Tap Slippage (points)", minval=0, maxval=5, step=0.25, group=groupVwap)
minVwapDist = input.float(3.25, "Min Distance from VWAP (points)", minval=0, maxval=20, step=0.25, group=groupVwap)

//==================================================
// ENTRY SETTINGS
//==================================================
groupEntry = "Entry"
entryLookback = input.int(3, "Candles to Leave FVG After Tap", minval=2, maxval=10, group=groupEntry)

//==================================================
// VOLD REGIME SETTINGS
//==================================================
groupVold = "VOLD Regime"
voldSymbol      = input.string("USI:VOLD", "VOLD Symbol", group=groupVold)
voldLookback    = input.int(3, "VOLD Trend Lookback Candles", minval=2, maxval=10, group=groupVold)
voldConsLookback = input.int(8, "VOLD Consolidation Lookback", minval=4, maxval=20, group=groupVold)
voldConsThresh  = input.float(0.3, "VOLD Consolidation Range %", minval=0.1, maxval=2.0, step=0.1, group=groupVold)
voldMinConsLen  = input.int(4, "VOLD Min Consolidation Length", minval=3, maxval=15, group=groupVold)

//==================================================
// TIME HELPERS
//==================================================
chartTfMin = timeframe.in_seconds(timeframe.period) / 60.0
chartTfMs  = timeframe.in_seconds(timeframe.period) * 1000
rightMs    = extendBars * chartTfMs
sessionLenMin = 390

inSess  = not na(time(timeframe.period, sessionRTH))
newSess = inSess and not inSess[1]

var int barsFromOpen = 0
barsFromOpen := newSess ? 1 : inSess ? (barsFromOpen + 1) : 0
minsFromOpen = inSess ? (barsFromOpen - 1) * chartTfMin : na
entryWindow = inSess and minsFromOpen >= entryStartMin and minsFromOpen <= (sessionLenMin - entryStopMin)

//==================================================
// 5m SERIES (direct request)
//==================================================
[o5,  h5,  l5,  c5,  t5]  = request.security(syminfo.tickerid, "5",  [open, high, low, close, time],  barmerge.gaps_off, barmerge.lookahead_off)
[o15, h15, l15, c15, t15] = request.security(syminfo.tickerid, "15", [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)

//==================================================
// 5m FVG DETECTION (ICT 3-candle, works fine with request.security)
//==================================================
bull5  = l5  > h5[2]
bear5  = h5  < l5[2]

//==================================================
// 15m FVG DETECTION (fixed: use completed candles only)
// On a 5m chart, h15[1] is the same 15m candle from
// the previous 5m bar, NOT the prior 15m candle.
// We store completed 15m candle OHLC and only detect
// FVGs when a new 15m candle starts.
//==================================================
bool new15mBar = t15 != t15[1]

// Store last 3 completed 15m candle highs/lows/times
var float comp15H_1 = na   // most recently completed
var float comp15L_1 = na
var int   comp15T_1 = na
var float comp15H_2 = na   // second most recent
var float comp15L_2 = na
var int   comp15T_2 = na
var float comp15H_3 = na   // oldest (third)
var float comp15L_3 = na
var int   comp15T_3 = na

if new15mBar
    // Shift: the candle that just completed is h15[1]/l15[1] on this bar
    comp15H_3 := comp15H_2
    comp15L_3 := comp15L_2
    comp15T_3 := comp15T_2
    comp15H_2 := comp15H_1
    comp15L_2 := comp15L_1
    comp15T_2 := comp15T_1
    comp15H_1 := h15[1]
    comp15L_1 := l15[1]
    comp15T_1 := t15[1]

// 15m FVG only fires on new 15m candle with 3 completed candles
// Bull: newest completed low > oldest completed high
// Bear: newest completed high < oldest completed low
bool bull15 = new15mBar and not na(comp15L_1) and not na(comp15H_3) and comp15L_1 > comp15H_3
bool bear15 = new15mBar and not na(comp15H_1) and not na(comp15L_3) and comp15H_1 < comp15L_3

float top15val = bull15 ? comp15L_1 : (bear15 ? comp15L_3 : na)
float bot15val = bull15 ? comp15H_3 : (bear15 ? comp15H_1 : na)
int   lt15val  = comp15T_3

//==================================================
// VOLD REGIME FUNCTIONS
//==================================================
f_candleDir(_o, _h, _l, _c) =>
    _bodySize = _c - _o
    _wickSize = _h - _l
    _wickSize == 0 ? 0.0 : _bodySize / _wickSize * 100

f_voldRegime(voldO, voldH, voldL, voldC, voldT, _lookback, _consLookback, _consThresh, _minConsLen) =>
    // Session detection
    bool _isNewSession = na(voldT[1]) or ta.change(time("D")) != 0
    var int _barsInSession = 0
    if _isNewSession
        _barsInSession := 0
    else
        _barsInSession += 1

    // Calculate scores for recent candles
    float _netBias = 0.0
    int _bullCount = 0
    int _bearCount = 0
    int _validBars = math.min(_lookback, _barsInSession)

    if _validBars > 0
        float _sumScores = 0.0
        for i = 0 to _validBars - 1
            _score = f_candleDir(voldO[i], voldH[i], voldL[i], voldC[i])
            _sumScores += _score
            if _score > 5
                _bullCount += 1
            else if _score < -5
                _bearCount += 1
        _netBias := _sumScores / _validBars

    // Consolidation detection
    var int _consCount = 0
    var bool _inConsol = false

    if _isNewSession
        _consCount := 0
        _inConsol := false

    if _barsInSession >= _consLookback
        _rangeHigh = ta.highest(voldH, _consLookback)
        _rangeLow = ta.lowest(voldL, _consLookback)
        _rangeSize = _rangeHigh - _rangeLow
        _midPoint = (_rangeHigh + _rangeLow) / 2
        _rangePct = math.abs(_midPoint) > 0 ? (_rangeSize / math.abs(_midPoint)) * 100 : 0.0

        if _rangePct < _consThresh
            _consCount += 1
            if _consCount >= _minConsLen
                _inConsol := true
        else
            if _inConsol
                _consCount := 0
                _inConsol := false
            else
                _consCount := 0
    else
        _consCount := 0
        _inConsol := false

    // Trend determination
    var int _trendDir = 0
    if _isNewSession
        _trendDir := 0

    if not _inConsol and _barsInSession >= _lookback
        if _bullCount >= _lookback * 0.6
            _trendDir := 1
        else if _bearCount >= _lookback * 0.6
            _trendDir := -1
        else if _netBias > 15
            _trendDir := 1
        else if _netBias < -15
            _trendDir := -1
        else
            _recentScore = f_candleDir(voldO, voldH, voldL, voldC)
            _prevScore = f_candleDir(voldO[1], voldH[1], voldL[1], voldC[1])
            _recentBias = (_recentScore * 2 + _prevScore) / 3
            if _recentBias > 10
                _trendDir := 1
            else if _recentBias < -10
                _trendDir := -1
            else
                _trendDir := 0
    else if _inConsol
        _trendDir := 0

    _trendDir

//==================================================
// VOLD DATA REQUEST & REGIME CALCULATION
//==================================================
[voldO5, voldH5, voldL5, voldC5, voldT5] = request.security(voldSymbol, "5", [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_off)

int voldRegime = f_voldRegime(voldO5, voldH5, voldL5, voldC5, voldT5, voldLookback, voldConsLookback, voldConsThresh, voldMinConsLen)

bool voldBullish = voldRegime == 1
bool voldBearish = voldRegime == -1

//==================================================
// STORAGE ARRAYS
//==================================================
var box[]   boxes   = array.new_box()
var label[] labels  = array.new_label()
var int[]   tfMin   = array.new_int()
var bool[]  isBull  = array.new_bool()
var float[] topArr  = array.new_float()
var float[] botArr  = array.new_float()
var int[]   leftT   = array.new_int()
var int[]   state   = array.new_int()      // 0=unfilled, 1=filled, 2=inversed
var bool[]  entStarted = array.new_bool()
var int[]   entLeft    = array.new_int()
var bool[]  vwapTap    = array.new_bool()
var int[]   lastTFt    = array.new_int()

//==================================================
// HELPERS
//==================================================
f_tfText(_tf) => _tf == 15 ? txt15 : txt5

f_hideBoxLabel(_bx, _lb) =>
    box.set_bgcolor(_bx, color.new(color.white, 100))
    box.set_border_color(_bx, color.new(color.white, 100))
    label.set_text(_lb, "")
    label.set_textcolor(_lb, color.new(color.white, 100))
    label.set_color(_lb, color.new(color.white, 100))

f_shouldShow(_tf, _bull, _st) =>
    bool tfOk = (_tf == 5 and show5mTF) or (_tf == 15 and show15mTF)
    if not tfOk
        false
    else if _st == 2
        showInversed
    else if _st == 0
        showUnfilled
    else
        showFilled

f_applyStyle(_bx, _lb, _tf, _bull, _st) =>
    if not f_shouldShow(_tf, _bull, _st)
        f_hideBoxLabel(_bx, _lb)
    else
        if _st == 2
            box.set_bgcolor(_bx, invBox)
            box.set_border_color(_bx, invBord)
            label.set_text(_lb, txtInv)
            label.set_textcolor(_lb, invText)
            label.set_color(_lb, labelBgCol)
        else if _bull
            if _st == 0
                box.set_bgcolor(_bx, bullUnfilledBox)
                box.set_border_color(_bx, bullUnfilledBord)
                label.set_text(_lb, f_tfText(_tf))
                label.set_textcolor(_lb, bullUnfilledText)
                label.set_color(_lb, labelBgCol)
            else
                box.set_bgcolor(_bx, bullFilledBox)
                box.set_border_color(_bx, bullFilledBord)
                label.set_text(_lb, f_tfText(_tf))
                label.set_textcolor(_lb, bullFilledText)
                label.set_color(_lb, labelBgCol)
        else
            if _st == 0
                box.set_bgcolor(_bx, bearUnfilledBox)
                box.set_border_color(_bx, bearUnfilledBord)
                label.set_text(_lb, f_tfText(_tf))
                label.set_textcolor(_lb, bearUnfilledText)
                label.set_color(_lb, labelBgCol)
            else
                box.set_bgcolor(_bx, bearFilledBox)
                box.set_border_color(_bx, bearFilledBord)
                label.set_text(_lb, f_tfText(_tf))
                label.set_textcolor(_lb, bearFilledText)
                label.set_color(_lb, labelBgCol)

f_deleteAt(_i) =>
    box.delete(array.remove(boxes, _i))
    label.delete(array.remove(labels, _i))
    array.remove(tfMin, _i)
    array.remove(isBull, _i)
    array.remove(topArr, _i)
    array.remove(botArr, _i)
    array.remove(leftT, _i)
    array.remove(state, _i)
    array.remove(entStarted, _i)
    array.remove(entLeft, _i)
    array.remove(vwapTap, _i)
    array.remove(lastTFt, _i)

f_inside(_topSmall, _botSmall, _topBig, _botBig) =>
    _topSmall <= _topBig and _botSmall >= _botBig

// Check if two FVG zones overlap (any price overlap)
f_overlaps(_top1, _bot1, _top2, _bot2) =>
    _top1 >= _bot2 and _top2 >= _bot1

// Enforce separate caps for inversed vs non-inversed FVGs
f_enforceCapInversed() =>
    int cnt = 0
    int sz = array.size(boxes)
    if sz > 0
        for j = sz - 1 to 0
            if array.get(state, j) == 2
                cnt += 1
                if cnt > maxIfvgs
                    f_deleteAt(j)

f_enforceCapNormal() =>
    int cnt = 0
    int sz = array.size(boxes)
    if sz > 0
        for j = sz - 1 to 0
            if array.get(state, j) != 2
                cnt += 1
                if cnt > maxNormalFvgs
                    f_deleteAt(j)

// Remove any IFVG that overlaps with a newly created non-inversed FVG
// but always keep the most recently created IFVG
f_removeOverlappingIfvg(_top, _bot) =>
    int sz = array.size(boxes)
    if sz > 0
        // Find the most recent IFVG (highest index)
        int newestIfvgIdx = -1
        for j = sz - 1 to 0
            if array.get(state, j) == 2
                newestIfvgIdx := j
                break
        // Remove overlapping IFVGs, skipping the most recent one
        for j = sz - 1 to 0
            if array.get(state, j) == 2 and j != newestIfvgIdx
                if f_overlaps(array.get(topArr, j), array.get(botArr, j), _top, _bot)
                    f_deleteAt(j)

f_addFvg(_tf, _bull, _top, _bot, _leftTime) =>
    if (_tf == 5 and not show5mTF) or (_tf == 15 and not show15mTF)
        na
    else
        int rT = _leftTime + rightMs
        float midP = (_top + _bot) / 2.0
        int midT = _tf == 15 ? int(math.round(_leftTime + (rT - _leftTime) * 0.5)) : (_leftTime + int((rT - _leftTime) / 2))

        box bx = box.new(left=_leftTime, right=rT, top=_top, bottom=_bot, xloc=xloc.bar_time, bgcolor=invBox, border_color=invBord)
        label lb = label.new(x=midT, y=midP, xloc=xloc.bar_time, yloc=yloc.price, text=f_tfText(_tf),
            style=label.style_label_center, color=labelBgCol, textcolor=invText, size=size.small)

        array.push(boxes, bx)
        array.push(labels, lb)
        array.push(tfMin, _tf)
        array.push(isBull, _bull)
        array.push(topArr, _top)
        array.push(botArr, _bot)
        array.push(leftT, _leftTime)
        array.push(state, 0)
        array.push(entStarted, false)
        array.push(entLeft, 0)
        array.push(vwapTap, false)
        array.push(lastTFt, na)

        // Remove overlapping IFVGs when a new normal FVG is created
        f_removeOverlappingIfvg(_top, _bot)

        // Enforce caps
        f_enforceCapNormal()

//==================================================
// SESSION VWAP
//==================================================
var float cumPV = na
var float cumV  = na
var float prevVWAP = na
var line[] vwapLines = array.new_line()

if newSess
    cumPV := 0.0
    cumV  := 0.0
    prevVWAP := na

float sessVWAP = na
if inSess
    tp = (high + low + close) / 3.0
    cumPV += tp * volume
    cumV  += volume
    sessVWAP := cumV != 0 ? (cumPV / cumV) : na

    if not na(sessVWAP)
        if not na(prevVWAP)
            line ln = line.new(bar_index - 1, prevVWAP, bar_index, sessVWAP,
                xloc=xloc.bar_index, extend=extend.none, color=vwapCol, width=vwapWidth)
            array.push(vwapLines, ln)
        prevVWAP := sessVWAP

maxLines = int(math.ceil((sessionLenMin / chartTfMin) * keepVwapSessions))
while array.size(vwapLines) > maxLines
    line.delete(array.shift(vwapLines))

//==================================================
// 15m PRIORITY + ADD NEW FVGs
//==================================================
if (bull15 or bear15) and show15mTF and not na(top15val) and not na(bot15val)
    f_addFvg(15, bull15, top15val, bot15val, lt15val)

    // Remove 5m FVGs fully inside this new 15m FVG
    int nRem = array.size(boxes)
    if nRem > 0
        for j = nRem - 1 to 0
            if array.get(tfMin, j) == 5 and array.get(isBull, j) == bull15
                if f_inside(array.get(topArr, j), array.get(botArr, j), top15val, bot15val)
                    f_deleteAt(j)

// 5m FVG creation
if (bull5 or bear5) and show5mTF
    float top5n = bull5 ? l5 : l5[2]
    float bot5n = bull5 ? h5[2] : h5

    bool blockedBy15 = false
    if show15mTF
        int nChk = array.size(boxes)
        if nChk > 0
            for j = 0 to nChk - 1
                if array.get(tfMin, j) == 15 and array.get(isBull, j) == bull5
                    if f_inside(top5n, bot5n, array.get(topArr, j), array.get(botArr, j))
                        blockedBy15 := true

    if not blockedBy15
        f_addFvg(5, bull5, top5n, bot5n, t5[2])

//==================================================
// STATE UPDATES + VWAP-TAP BOUNCE ENTRIES
//==================================================
bool bullEntry = false
bool bearEntry = false

bool closeAboveVWAP = inSess and not na(sessVWAP) and (close - sessVWAP) >= minVwapDist
bool closeBelowVWAP = inSess and not na(sessVWAP) and (sessVWAP - close) >= minVwapDist

var bool needIfvgCap = false
needIfvgCap := false

int n = array.size(boxes)
if n > 0
    for i = 0 to n - 1
        box  bx = array.get(boxes, i)
        label lb = array.get(labels, i)

        int tf = array.get(tfMin, i)
        bool bull = array.get(isBull, i)
        float top = array.get(topArr, i)
        float bot = array.get(botArr, i)
        int lt = array.get(leftT, i)

        int st = array.get(state, i)
        bool ent = array.get(entStarted, i)
        int  cd  = array.get(entLeft, i)
        bool tap = array.get(vwapTap, i)
        int lastT = array.get(lastTFt, i)

        int   curT = tf == 5 ? t5 : t15
        float curH = tf == 5 ? h5 : h15
        float curL = tf == 5 ? l5 : l15
        float curC = tf == 5 ? c5 : c15
        float curO = tf == 5 ? o5 : o15

        bool newTFCandle = curT != lastT

        if newTFCandle and curT > lt
            enteredNow = (curL <= top) and (curH >= bot)
            if st == 0 and enteredNow
                st := 1

            if st == 1
                if (bull and curC < bot) or ((not bull) and curC > top)
                    st := 2
                    needIfvgCap := true

            if st != 2
                if (not ent) and enteredNow
                    ent := true
                    cd := entryLookback
                    tap := false

                if ent and cd > 0
                    if inSess and not na(sessVWAP)
                        bool vwapTapValid = bull ? (low <= sessVWAP + vwapSlippage) : (high >= sessVWAP - vwapSlippage)
                        if vwapTapValid
                            tap := true

                    bullishCandle = curC > curO
                    bearishCandle = curC < curO

                    bullConfirm = bull and tap and bullishCandle and (curC > top) and closeAboveVWAP
                    bearConfirm = (not bull) and tap and bearishCandle and (curC < bot) and closeBelowVWAP

                    if entryWindow
                        if bullConfirm and voldBullish
                            bullEntry := true
                            ent := false
                            cd := 0
                            tap := false
                        if bearConfirm and voldBearish
                            bearEntry := true
                            ent := false
                            cd := 0
                            tap := false

                    cd := cd - 1
                    if cd <= 0
                        ent := false
                        cd := 0
                        tap := false

        array.set(state, i, st)
        array.set(entStarted, i, ent)
        array.set(entLeft, i, cd)
        array.set(vwapTap, i, tap)
        array.set(lastTFt, i, curT)

        f_applyStyle(bx, lb, tf, bull, st)

        if tf == 15
            int rT = lt + rightMs
            int midT = int(math.round(lt + (rT - lt) * 0.5))
            float midP = (top + bot) / 2.0
            label.set_x(lb, midT)
            label.set_y(lb, midP)

// Deferred IFVG cap enforcement (after loop to avoid index-out-of-bounds)
if needIfvgCap
    f_enforceCapInversed()

//==================================================
// ENTRY DOTS
//==================================================
plotshape(bullEntry, title="Bullish Entry", style=shape.circle, location=location.belowbar, size=size.tiny, color=color.green)
plotshape(bearEntry, title="Bearish Entry", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.red)

//==================================================
// VOLD REGIME BACKGROUND
//==================================================
bgcolor(voldBullish ? color.new(color.green, 95) : voldBearish ? color.new(color.red, 95) : color.new(color.gray, 98), title="VOLD Regime BG")
